APP_ENV=development
APP_NAME=Abhyaas API
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/abhyaas
JWT_SECRET=replace-this-with-a-long-random-value
JWT_ISSUER=abhyaas-api
JWT_AUDIENCE=abhyaas-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
EMAIL_TOKEN_MINUTES=30
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Abhyaas
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback
