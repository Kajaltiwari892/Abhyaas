# Safe starter configuration; contains no real credentials.
# Copy to .env only for a fresh setup. Never overwrite an existing .env.
APP_ENV=development
APP_NAME=Abhyaas API
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/abhyaas
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_BEFORE_USE
JWT_ISSUER=abhyaas-api
JWT_AUDIENCE=abhyaas-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Local reset links are printed to backend logs. Use SMTP for real delivery.
EMAIL_PROVIDER=console
EMAIL_TOKEN_MINUTES=30
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Abhyaas
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true

# Optional Google sign-in. Match the redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback

# No API key means generation/embeddings are unavailable.
GEMINI_API_KEY=
# GEMINI_MODEL and GEMINI_FALLBACK_MODEL use app/core/config.py defaults.
# Override with model IDs available to your own provider account if needed.

# Local Qdrant is single-process. Production needs QDRANT_URL and usually a key.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./data/qdrant
RAG_COLLECTION=abhyaas_knowledge_v1
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_DAILY_LIMIT=30
# Per-student daily cap for new Similar practice questions (bank practice is unaffected).
PRACTICE_AI_MODEL=gemini-2.5-flash
PRACTICE_AI_DAILY_QUESTIONS=250
